# PostgreSQL (production). Хоосон бол dev-д memory storage ашиглана.
DATABASE_URL=postgresql://user:pass@localhost:5432/travel_hub

# Имэйл (Gmail жишээ — App Password ашиглана)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=olonnuurtravel@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Olon Nuur Travel" <olonnuurtravel@gmail.com>
BOOKING_NOTIFY_EMAIL=olonnuurtravel@gmail.com

# Make.com → KakaoTalk автомат мессеж
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# Банкны данс
BANK_NAME=Худалдаа хөгжил банк
BANK_ACCOUNT_NUMBER=MN35 0004 000 433070088
BANK_ACCOUNT_HOLDER=Олон Нуур Трэвел
BANK_TRANSFER_DEADLINE_HOURS=48

# Admin team access (olonnuurtravel.mn/ont1, /ont2, /ont3)
SESSION_SECRET=change_this_to_a_long_random_string
ONT1_PASSWORD=your_strong_password_here
ONT2_PASSWORD=your_strong_password_here
ONT3_PASSWORD=your_strong_password_here
# Production HTTP (no HTTPS): SESSION_SECURE=false
