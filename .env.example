# PostgreSQL. Production requires DATABASE_URL for durable booking storage.
DATABASE_URL=postgresql://user:pass@localhost:5432/travel_hub

# Local development only. Never enable memory storage in production.
# BOOKING_STORAGE=memory

# Имэйл (Gmail жишээ — App Password ашиглана)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=olonnuurtravel@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Olon Nuur Travel" <olonnuurtravel@gmail.com>
BOOKING_NOTIFY_EMAIL=olonnuurtravel@gmail.com

# Make.com → KakaoTalk автомат мессеж
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# Банкны данс
